{
  "title": "UNO Power-Ups Arena - KPIs de Negocio (HU-11)",
  "uid": "uno-kpis-negocio",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "type": "text",
      "title": "Zonas de aterrizaje (Inception seccion 5, HU-11)",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "| KPI | Minimo | Objetivo | Excepcional |\n|---|---|---|---|\n| KPI-1 Partidas completadas / dia | >= 5 | >= 10 | >= 25 |\n| KPI-2 Latencia p95 jugada -> broadcast | < 400 ms | < 200 ms | < 100 ms |\n| KPI-3 Salas concurrentes sin degradacion | >= 10 | >= 20 | >= 50 |\n| KPI-4 Tasa de partidas sin errores criticos | >= 90% | >= 95% | >= 99% |"
      }
    },
    {
      "type": "stat",
      "title": "KPI-1: Partidas completadas (ultimas 24h)",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 25 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(increase(uno_partidas_completadas_total[24h])) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "KPI-2: Latencia p95 jugada -> broadcast (5m)",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "orange", "value": 0.2 },
              { "color": "red", "value": 0.4 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(uno_jugada_broadcast_seconds_bucket[5m])))" }
      ]
    },
    {
      "type": "stat",
      "title": "KPI-3: Salas concurrentes en juego (ahora)",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 20 },
              { "color": "purple", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "uno_partidas_activas or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "KPI-4: Tasa de partidas sin errores criticos (24h)",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "1 - (sum(increase(uno_partidas_errores_total[24h])) or vector(0)) / clamp_min(sum(increase(uno_partidas_completadas_total[24h])) or vector(1), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Partidas completadas por hora",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "targets": [
        { "expr": "sum(increase(uno_partidas_completadas_total[1h]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia jugada -> broadcast (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(uno_jugada_broadcast_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(uno_jugada_broadcast_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(uno_jugada_broadcast_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    }
  ]
}
